# ====================================================================
# JUSTICEVAULT CONFIGURATION TEMPLATE
# Smart India Hackathon 2026 | Problem Statement: SIH26190 | Team: GenX
# ====================================================================

# 1. CORE SERVER & CRYPTOGRAPHY
PORT=8000
JUSTICEVAULT_SECRET=justicevault-super-secure-production-secret-key-2026
JUSTICEVAULT_FERNET_KEY=
JWT_EXPIRATION_HOURS=12

# 2. DATABASE CONFIGURATION
# Set to 'sqlite' for zero-setup demo or 'postgres' for containerized production
DATABASE_TYPE=sqlite
DATABASE_URL=postgresql://postgres:justicevault2026@localhost:5432/justicevault_db

# 3. ENCRYPTED CLOUD / OBJECT STORAGE (StorageService)
# Compatible with AWS S3, MinIO, or National Informatics Centre (NIC) Cloud
STORAGE_DRIVER=local
S3_ENDPOINT_URL=https://s3.ap-south-1.amazonaws.com
S3_BUCKET_NAME=justicevault-evidence-secure
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-south-1

# 4. HYPERLEDGER FABRIC INTEGRATION
# Options: 'MOCK_FABRIC_ADAPTER' (Demo Mode) | 'FABRIC_REAL' (Production Peer Network)
BLOCKCHAIN_MODE=MOCK_FABRIC_ADAPTER
FABRIC_CHANNEL=channel-legal-evidence
FABRIC_CHAINCODE=evidence_cc
FABRIC_CONNECTION_PROFILE=./blockchain/network/connection-profile.json
FABRIC_CA_URL=https://ca.justicevault.gov.in:7054

# 5. SECURITY & AUDIT
CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=120
ESIGN_HMAC_SECRET=justicevault-esign-ceremony-secret-2026
